.icl-Icon {
  box-sizing: border-box;
  display: inline-block;
  vertical-align: middle;
  height: 3rem;
  width: 3rem; }

.icl-Icon--input {
  display: inline-block;
  position: absolute;
  height: 44px;
  width: 40px;
  fill: #ccc;
  bottom: 0; }

.icl-Icon--md {
  height: 1.5rem;
  width: 1.5rem; }

.icl-Icon--sm {
  height: 1.125rem;
  width: 1.125rem; }

[dir=ltr] .icl-Icon--right {
  margin-left: .2rem;
  right: 0; }

[dir=rtl] .icl-Icon--right {
  margin-right: .2rem;
  left: 0; }

[dir=ltr] .icl-Icon--left {
  margin-right: .2rem; }

[dir=rtl] .icl-Icon--left {
  margin-left: .2rem; }

.icl-Icon--black {
  fill: #000; }

.icl-Icon--blue {
  fill: #085ff7; }

.icl-Icon--grey {
  fill: #ccc; }

.icl-Icon--darkgrey {
  fill: #909090; }

.icl-Icon--orange {
  fill: #ff5a1f; }

.icl-Icon--white {
  fill: #fff; }

.icl-Icon--inheritColor {
  fill: currentColor; }

